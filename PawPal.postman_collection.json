{
  "info": {
    "name": "PawPal API — E2E Test Suite",
    "description": "End-to-end test of the PawPal backend, matching API_REFERENCE.md.\n\nHow to use:\n1. Start the stack: `docker compose up -d` then `.\\mvnw.cmd spring-boot:run` in backend/\n2. Import this file into Postman\n3. Click the collection → Run → keep the default order → Run PawPal API\n\nEvery request has assertions; a full run should be all green. Requests that intentionally provoke errors (401/400/409) assert those codes, so they pass when the API correctly rejects them.\n\nEach run registers fresh users (timestamped emails), so you can re-run without cleanup. Tokens and IDs are captured automatically into collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "aliceEmail", "value": "" },
    { "key": "bobEmail", "value": "" },
    { "key": "aliceToken", "value": "" },
    { "key": "bobToken", "value": "" },
    { "key": "aliceId", "value": "" },
    { "key": "bobId", "value": "" },
    { "key": "buddyId", "value": "" },
    { "key": "lunaId", "value": "" },
    { "key": "invitationId", "value": "" },
    { "key": "matchId", "value": "" },
    { "key": "itemId", "value": "" },
    { "key": "invDateTime", "value": "" }
  ],
  "item": [
    {
      "name": "0 · Health",
      "item": [
        {
          "name": "Backend is up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('backend responds 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/system/health"
          }
        }
      ]
    },
    {
      "name": "1 · Auth",
      "item": [
        {
          "name": "Register Alice",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('aliceEmail', `alice_${Date.now()}@test.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with token/userId/name/email', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const j = pm.response.json();",
                  "  pm.expect(j).to.have.keys('token','userId','name','email','role');",
                  "  pm.collectionVariables.set('aliceToken', j.token);",
                  "  pm.collectionVariables.set('aliceId', j.userId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice\",\n  \"email\": \"{{aliceEmail}}\",\n  \"password\": \"secret1\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Register Bob",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('bobEmail', `bob_${Date.now()}@test.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with token', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set('bobToken', j.token);",
                  "  pm.collectionVariables.set('bobId', j.userId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob\",\n  \"email\": \"{{bobEmail}}\",\n  \"password\": \"secret1\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login Alice (valid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 and BCrypt login works', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().token).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{aliceEmail}}\",\n  \"password\": \"secret1\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login wrong password → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 rejected', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{aliceEmail}}\",\n  \"password\": \"wrong\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Register short password → 400 validation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 with readable message', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().message).to.include('at least 6');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"X\",\n  \"email\": \"shortpw_{{$timestamp}}@test.com\",\n  \"password\": \"ab\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        }
      ]
    },
