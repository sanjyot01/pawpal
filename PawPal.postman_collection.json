                  "  pm.expect(m).to.exist;",
                  "  pm.expect(m.status).to.eql('accepted');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{aliceToken}}" }],
            "url": "{{baseUrl}}/api/matches"
          }
        }
      ]
