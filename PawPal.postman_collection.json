            },
            "url": "{{baseUrl}}/api/telemetry/location"
          }
        },
        {
          "name": "Nearby pets on the map",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Location flows through Kafka → Redis; give the consumer a moment",
                  "await new Promise(resolve => setTimeout(resolve, 2500));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Buddy appears as a map pin', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const buddy = pm.response.json().find(p => p.name === 'Buddy');",
                  "  pm.expect(buddy, 'pin for Buddy (if missing, re-send telemetry and retry)').to.exist;",
                  "  pm.expect(buddy.latitude).to.be.closeTo(43.651, 0.01);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/pets/nearby?lat=43.65&lon=-79.38&radiusKm=5"
          }
