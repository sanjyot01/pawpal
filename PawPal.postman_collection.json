    {
      "name": "4 · Match flow (Bearer required)",
      "item": [
        {
          "name": "No token → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 without Bearer token', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/matches"
          }
        },
        {
          "name": "Alice: Buddy → Luna blind-date request",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('pending outgoing match', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.status).to.eql('pending');",
                  "  pm.expect(j.direction).to.eql('outgoing');",
                  "  pm.expect(j.otherPet.name).to.eql('Luna');",
                  "  pm.collectionVariables.set('matchId', j.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{aliceToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requesterPetId\": {{buddyId}},\n  \"targetPetId\": {{lunaId}},\n  \"matchType\": \"BLIND_DATE\",\n  \"notes\": \"Would love to meet!\"\n}"
            },
            "url": "{{baseUrl}}/api/matches"
          }
        },
        {
          "name": "Bob: reverse pair Luna → Buddy → 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 reverse-pair duplicate blocked', () => {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.json().message).to.include('already exists');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{bobToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requesterPetId\": {{lunaId}},\n  \"targetPetId\": {{buddyId}},\n  \"matchType\": \"BLIND_DATE\"\n}"
            },
            "url": "{{baseUrl}}/api/matches"
          }
        },
        {
          "name": "Alice tries to accept her own request → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 requester cannot self-accept', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{aliceToken}}" }],
            "url": "{{baseUrl}}/api/matches/{{matchId}}/accept"
          }
        },
        {
          "name": "Bob accepts the request",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('accepted, oriented to Bob', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.status).to.eql('accepted');",
                  "  pm.expect(j.direction).to.eql('incoming');",
                  "  pm.expect(j.myPet.name).to.eql('Luna');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{bobToken}}" }],
            "url": "{{baseUrl}}/api/matches/{{matchId}}/accept"
          }
        },
        {
          "name": "Alice lists her matches",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
