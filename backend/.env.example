# Copy to .env and fill in. .env is gitignored — never commit real values.
#   cp .env.example .env
#
# Used by docker-compose.aws.yml (single-instance deployment). Compose refuses to
# start if APP_JWT_SECRET, DB_USERNAME or DB_PASSWORD are missing, rather than
# falling back to a shared default that would be identical on every deployment.

# Signs every session token. Anyone who can read this can forge a token for any
# user, so it must never be committed or reused across environments.
#   generate:  openssl rand -base64 48
APP_JWT_SECRET=

DB_USERNAME=pawpal
DB_PASSWORD=

# Your app's origin. "*" is dev-only — it lets any site call the API from a browser.
APP_CORS_ALLOWED_ORIGINS=*

# Grafana admin login (http://<PUBLIC_IP>:3000). Compose refuses to start without a
# password rather than shipping "admin" to a port that is open to the internet.
#   generate:  openssl rand -base64 24
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Password for the seeded demo accounts (see POST /api/demo/seed). Leave APP_DEMO_SEED_ENABLED
# unset in a deployment you care about — the seeder writes users, pets and posts.
APP_DEMO_SEED_ENABLED=false
APP_DEMO_SEED_PASSWORD=
