# Copy to .env on each of the three instances and fill in. Never commit the real .env
# (backend/.gitignore excludes it) — prefer SSM Parameter Store and inject at boot.

# --- instance private IPs (not public: only the ALB faces the internet) ---
NODE_A_IP=10.0.1.10
NODE_B_IP=10.0.2.10
WITNESS_IP=10.0.3.10

# --- app image, from ECR ---
APP_IMAGE=<acct>.dkr.ecr.<region>.amazonaws.com/pawpal-backend:latest

# --- managed Postgres ---
RDS_ENDPOINT=pawpal.abc123.us-east-1.rds.amazonaws.com
DB_USERNAME=pawpal
DB_PASSWORD=

# --- Redis Sentinel ---
# Logical name of the monitored primary; the app resolves the current primary
# through Sentinel using this name, so a failover needs no redeploy.
REDIS_MASTER_NAME=pawpal

# --- Kafka ---
# Generate once with: docker run --rm confluentinc/cp-kafka:7.5.0 kafka-storage random-uuid
KAFKA_CLUSTER_ID=

# --- app ---
# Generate with: openssl rand -base64 48
APP_JWT_SECRET=
APP_CORS_ALLOWED_ORIGINS=https://your-app-domain
